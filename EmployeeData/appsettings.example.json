{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost,1433;Database=EmployeeData;User Id=sa;Password=<set-outside-source-control>;TrustServerCertificate=True"
  },
  "Jwt": {
    "Issuer": "EmployeeData.Api",
    "Audience": "EmployeeData.Client",
    "AccessTokenMinutes": 60,
    "ActiveKeyId": "replace-with-key-id",
    "SigningKeys": {
      "replace-with-key-id": "<base64-encoded-random-key-of-at-least-32-bytes>"
    }
  },
  "BootstrapAdmin": {
    "Enabled": false,
    "RotateLegacySeed": false,
    "UserName": "",
    "Password": "",
    "ProfilePictureUrl": null
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
